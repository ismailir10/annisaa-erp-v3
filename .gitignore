# env files — NEVER commit these. Deny-by-default: an ad-hoc dump such as
# `.env.doku-probe` matched none of the old explicit patterns and sat one
# `git add -A` away from committing live service-role and gateway secrets.
.env*
!.env.example

# Next.js
.next/
out/

# Node — no trailing slash: `node_modules` is a symlink inside every worktree
# created by setup-worktree.sh, and `node_modules/` does not match a symlink.
node_modules

# OS
.DS_Store

# Prisma
prisma/migrations/*.sql.bak
lib/generated/prisma

# SQLite dev database
dev.db
dev.db-journal
prisma/dev.db

# Vitest
coverage/

# IDE
.vscode/
.idea/
.claude/worktrees/
.worktrees/

# Session-local state (written by the assistant on turn 1, per-session)
.claude/session-role
.githooks/.installed

# Harness-local scratch that belongs in ~/.claude, not the repo: agent plan
# artifacts and the per-project auto-memory store.
.claude/plans/
.claude/projects/

# Local binaries + UI captures. Keep them under artifacts/ if they matter —
# the Panduan .docx is 3 MB a copy and the .bak- rotations are pure churn.
*.docx
*.docx.bak-*

# Build / analysis artifacts
build.log
build-analyze.log
tsconfig.tsbuildinfo

# Reference material (large xlsx, third-party repos, etc.) — kept locally, never committed
artifacts/

# Third-party agent skill plugins (loaded from ~/.claude/, not this repo)
.agents/

# Brainstorm visual companion artifacts (per-session, ephemeral)
.superpowers/

# Playwright output
playwright-report/
test-results/

.playwright-mcp/
.vercel

# Local storage adapter uploads (lib/storage). Files written here are served
# only through auth-proxied API routes — never via Next static handler.
.data/

# codex harness-local session state (mirrors .claude/ session files)
.codex/
.roster-backup/
scripts/import-roster/stage.sql
scripts/import-roster/transform.sql
scripts/import-roster/rowhashes.tsv

# Names the Google accounts that hold admin/teacher/parent access. Public repo —
# keep it local. Copy .claude/verify-accounts.example.json to create it.
.claude/verify-accounts.json
